    "z": "000000000000a201",
    "name": "Make QA receipt",
    "func": "const url = String(msg.topic || ''); const body = String(msg.payload || ''); const status = Number(msg.statusCode || 0); let expected = false; if (url.includes('netmirrorfit.ai.studio/robots.txt')) expected = /Disallow:\\s*\\//i.test(body); else if (url.includes('robots.txt')) expected = /Sitemap:\\s*https:\\/\\/netmirror\\.fit\\/sitemap\\.xml/i.test(body); else if (url.includes('sitemap.xml')) expected = /<urlset\\b|<sitemapindex\\b/i.test(body); msg.payload = {checked_at_utc: new Date().toISOString(), url, status, passed: status === 200 && expected, read_only: true, scope: 'HTTP endpoint check only; not content accuracy or deployment validation'}; return msg;",
